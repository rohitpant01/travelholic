{
  "expo": {
    "name": "TravelHolic",
    "slug": "travelholic",
    "version": "1.0.0",
    "scheme": "travelholic",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00B4B4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.travelholic",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyCLYyVPFrMguQYp71lbDIxftCzMOF4d5JY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TravelHolic uses your location to show nearby travelers.",
        "NSLocationAlwaysUsageDescription": "TravelHolic uses your location to show nearby travelers.",
        "NSCameraUsageDescription": "TravelHolic uses the camera for photo verification selfies.",
        "NSPhotoLibraryUsageDescription": "TravelHolic uses your photo library for profile and travel photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00B4B4"
      },
      "package": "com.travelholic",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCLYyVPFrMguQYp71lbDIxftCzMOF4d5JY"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow TravelHolic to use your location to find nearby travelers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TravelHolic to access your photos.",
          "cameraPermission": "Allow TravelHolic to use your camera for verification."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow TravelHolic to save photos to your library.",
          "savePhotosPermission": "Allow TravelHolic to save photos to your library."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "6f07a716-0ff2-4eac-8462-3a2fa834fcad"
      }
    },
    "owner": "rohitpant01"
  }
}
